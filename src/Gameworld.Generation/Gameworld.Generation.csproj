<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Gameworld.Domain\Gameworld.Domain.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Gameworld.Tests" />
  </ItemGroup>

  <!-- The name models of Names/NameGenerator.cs. The resource name is the file name with the namespace in front. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\pregenerated-data\*_names_sets.json"
                      LogicalName="Gameworld.Generation.Names.%(Filename)%(Extension)"
                      Link="Names\Data\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
